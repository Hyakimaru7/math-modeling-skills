{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MathModeling bound paper content",
  "type": "object",
  "required": [
    "abstract",
    "sections"
  ],
  "properties": {
    "abstract": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "heading",
          "text",
          "question_ids"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
